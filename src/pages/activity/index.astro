---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { activities, activityTypes } from "../../data/activities";

const typeStyle = {
  Release: "bg-emerald-400 text-emerald-950",
  Article: "bg-sky-400 text-sky-950",
  Mention: "bg-amber-300 text-amber-950",
  Adoption: "bg-violet-400 text-violet-950",
  Research: "bg-rose-400 text-rose-950",
};
const typeDot = {
  Release: "bg-emerald-400",
  Article: "bg-sky-400",
  Mention: "bg-amber-300",
  Adoption: "bg-violet-400",
  Research: "bg-rose-400",
};
---

<Layout title="Activity — kinn00kinn" description="リリース、記事、外部言及、採用、研究を同じ時系列でたどる活動ログ。">
  <div class="min-h-screen overflow-x-hidden bg-[#f4f2ee] text-zinc-900 transition-colors dark:bg-[#070707] dark:text-zinc-100">
    <SiteHeader />
    <main class="mx-auto max-w-5xl px-4 py-12 md:px-8 md:py-20">
      <section class="mb-10 border-b-2 border-zinc-900 pb-10 dark:border-zinc-700">
        <p class="mb-3 font-mono text-xs font-black uppercase tracking-[0.22em] text-emerald-700 dark:text-emerald-300">// Activity graph</p>
        <h1 class="text-5xl font-black tracking-[-0.06em] text-zinc-950 dark:text-white md:text-7xl">Activity</h1>
        <p class="mt-5 max-w-2xl text-base font-medium leading-relaxed text-zinc-600 dark:text-zinc-300 md:text-lg">作る、書く、調べる。種類を分けず一つの時間軸に流しています。</p>
        <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[10px] font-black uppercase tracking-wider text-zinc-600 dark:text-zinc-300">
          {activityTypes.map((type) => <li class="flex items-center gap-2"><span class:list={["h-3 w-3 rounded-[3px] border border-zinc-900/40", typeDot[type]]}></span>{type}</li>)}
        </ul>
      </section>

      <ol class="activity-graph relative">
        {activities.map((activity, index) => {
          const { date: dateValue, type, title, description, url } = activity;
          const date = new Date(`${dateValue}T00:00:00+09:00`);
          const CardTag = url ? "a" : "div";
          return (
            <li class="activity-row relative grid min-w-0 gap-3 pb-8 pl-16 md:grid-cols-[8rem_1fr] md:gap-6 md:pl-20">
              <div class:list={["activity-node absolute left-[21px] top-4 z-10 grid h-6 w-6 place-items-center rounded-[5px] border-2 border-zinc-900 shadow-[2px_2px_0_#18181b] dark:border-zinc-700 dark:shadow-[2px_2px_0_#27272a]", typeDot[type]]}>
                <span class="h-1.5 w-1.5 rounded-sm bg-zinc-950/60"></span>
              </div>
              <time datetime={date.toISOString()} class="pt-1 font-mono text-sm font-black tracking-tight text-zinc-500 dark:text-zinc-400">
                {date.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit" }).replaceAll("/", ".")}
              </time>
              <CardTag
                href={url}
                target={url ? "_blank" : undefined}
                rel={url ? "noreferrer" : undefined}
                class="group min-w-0 overflow-hidden rounded-xl border-2 border-zinc-900 bg-white p-5 shadow-[4px_4px_0_#18181b] transition-transform hover:-translate-y-0.5 dark:border-zinc-700 dark:bg-zinc-950 dark:shadow-[4px_4px_0_#27272a] md:p-6"
              >
                <div class="flex flex-wrap items-start justify-between gap-3">
                  <span class:list={["rounded px-2.5 py-1 font-mono text-[10px] font-black uppercase tracking-widest", typeStyle[type]]}>{type}</span>
                  <span class="font-mono text-[10px] text-zinc-400">ACT_{String(activities.length - index).padStart(3, "0")}</span>
                </div>
                <h2 class="mt-4 break-words text-xl font-black tracking-tight text-zinc-950 group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-300 md:text-2xl">{title}{url && <span class="ml-2 text-sm" aria-hidden="true">↗</span>}</h2>
                <p class="mt-2 break-words text-sm font-medium leading-relaxed text-zinc-600 dark:text-zinc-300">{description}</p>
              </CardTag>
            </li>
          );
        })}
      </ol>
    </main>
    <SiteFooter />
  </div>
</Layout>

<style>
  .activity-graph::before {
    content: "";
    position: absolute;
    left: 32px;
    top: 28px;
    bottom: 38px;
    width: 3px;
    background: repeating-linear-gradient(to bottom, #a1a1aa 0 9px, transparent 9px 14px);
  }
  :global(.dark) .activity-graph::before { background: repeating-linear-gradient(to bottom, #52525b 0 9px, transparent 9px 14px); }
  @media (min-width: 768px) {
    .activity-graph::before { left: 40px; }
    .activity-node { left: 29px; }
  }
</style>
