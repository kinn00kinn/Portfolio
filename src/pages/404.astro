---
import Layout from '../layouts/Layout.astro';
import { ArrowLeft } from 'lucide-react';
---

<Layout title="404 Not Found">
  <div class="flex flex-col items-center justify-center min-h-screen text-center px-4">
    <h1 class="mb-4 text-9xl font-black text-black dark:text-zinc-100">404</h1>
    <p class="text-xl text-gray-600 dark:text-gray-400 mb-8 font-bold">
      Page Not Found
    </p>
    <a 
      href="/" 
      class="flex items-center space-x-2 bg-black px-6 py-3 font-bold text-white transition-opacity hover:opacity-80 dark:bg-zinc-200 dark:text-zinc-900"
    >
      <ArrowLeft size={20} />
      <span>Back to Top</span>
    </a>
  </div>
</Layout>
