---
import Layout from "../../layouts/Layout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { profile } from "../../config";
import { getBlogArticles } from "../../lib/blog";
import { getZennArticles } from "../../lib/zenn";

const [zennArticles, blogArticles] = await Promise.all([
  getZennArticles(),
  getBlogArticles(),
]);
const articles = [...zennArticles, ...blogArticles].sort((a, b) =>
  b.pubDate.localeCompare(a.pubDate),
);
const groupedArticles = Object.entries(
  articles.reduce<Record<string, typeof articles>>((groups, article) => {
    const year = article.pubDate.slice(0, 4) || "Other";
    (groups[year] ??= []).push(article);
    return groups;
  }, {}),
).sort(([a], [b]) => b.localeCompare(a));
const articleCount = articles.length;
---

<Layout title="Writing — kinn00kinn" description="kinn00kinnが公開した技術記事と文章の索引。Zenn、Blog、Qiitaの原文へつながります。">
  <div class="min-h-screen bg-[#f4f2ee] text-zinc-900 transition-colors dark:bg-[#12110f] dark:text-zinc-200">
    <SiteHeader />
    <main class="mx-auto max-w-5xl px-4 py-12 md:px-8 md:py-20">
      <header class="border-b-2 border-zinc-900 pb-10 dark:border-zinc-700">
        <p class="mb-3 font-mono text-xs font-black uppercase tracking-[0.22em] text-emerald-700 dark:text-emerald-300">// Writing index</p>
        <h1 class="text-5xl font-black tracking-[-0.06em] text-zinc-950 dark:text-zinc-100 md:text-7xl">Writing</h1>
        <p class="mt-5 max-w-2xl text-base font-medium leading-relaxed text-zinc-600 dark:text-zinc-300 md:text-lg">学んだこと、作ったもの、その途中で考えたこと。本文は公開元で読めます。</p>
        <nav aria-label="執筆サービス" class="mt-7 flex flex-wrap gap-3">
          <a href={profile.blogUrl} target="_blank" rel="noreferrer" class="rounded-md border-2 border-zinc-900 bg-zinc-900 px-4 py-2.5 font-mono text-xs font-black uppercase text-white dark:border-zinc-600 dark:bg-zinc-200 dark:text-zinc-900">Blog ↗</a>
          <a href={profile.zennUrl} target="_blank" rel="noreferrer" class="rounded-md border-2 border-sky-500 bg-white px-4 py-2.5 font-mono text-xs font-black uppercase text-sky-700 dark:bg-[#1c1a17] dark:text-sky-300">Zenn ↗</a>
          <a href={profile.qiitaUrl} target="_blank" rel="noreferrer" class="rounded-md border-2 border-emerald-500 bg-white px-4 py-2.5 font-mono text-xs font-black uppercase text-emerald-700 dark:bg-[#1c1a17] dark:text-emerald-300">Qiita ↗</a>
        </nav>
      </header>

      <section aria-label="記事検索" class="mt-8 grid gap-4 rounded-xl border-2 border-zinc-900 bg-white p-4 dark:border-zinc-700 dark:bg-[#1c1a17] sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
          <label for="writing-search" class="mb-2 block font-mono text-xs font-black uppercase tracking-wider text-zinc-600 dark:text-zinc-300">Search writing</label>
          <input id="writing-search" type="search" autocomplete="off" placeholder="タイトル・公開元・年で検索…" class="w-full rounded-lg border-2 border-zinc-900 bg-[#f4f2ee] px-4 py-3 font-mono text-sm font-bold outline-none placeholder:text-zinc-400 focus:ring-4 focus:ring-emerald-300/60 dark:border-zinc-600 dark:bg-[#12110f] dark:text-zinc-100" />
        </div>
        <p id="writing-count" aria-live="polite" class="pb-1 font-mono text-xs font-black text-zinc-500">{articleCount} / {articleCount} ARTICLES</p>
      </section>

      <nav aria-label="年別リンク" class="mt-5 flex flex-wrap gap-2">
        {groupedArticles.map(([year]) => <a href={`#writing-${year}`} class="rounded-full border border-zinc-400 px-3 py-1.5 font-mono text-xs font-black hover:bg-zinc-200 dark:border-zinc-600 dark:hover:bg-[#26231f]">{year}</a>)}
      </nav>

      <div class="mt-12 space-y-16">
        {groupedArticles.map(([year, yearArticles]) => (
          <section id={`writing-${year}`} data-writing-year class="scroll-mt-24">
            <div class="mb-6 flex items-center gap-5">
              <h2 class="font-mono text-3xl font-black tracking-tight">{year}</h2>
              <span class="h-px flex-1 bg-zinc-400 dark:bg-zinc-700"></span>
              <span class="font-mono text-xs font-bold text-zinc-500">{yearArticles.length} ARTICLES</span>
            </div>
            <ol class="grid gap-4">
              {yearArticles.map((article) => (
                <li data-writing-item data-search={`${article.title} ${article.source} ${article.pubDate}`.toLocaleLowerCase("ja")}>
                  <a href={article.link} target="_blank" rel="noreferrer" class="group grid gap-3 rounded-xl border-2 border-zinc-900 bg-white p-5 shadow-[4px_4px_0_#18181b] transition-transform hover:-translate-y-0.5 dark:border-zinc-700 dark:bg-[#1c1a17] dark:shadow-[4px_4px_0_#090807] sm:grid-cols-[7rem_1fr_auto] sm:items-center">
                    <time datetime={article.pubDate} class="font-mono text-xs font-black text-zinc-500">{article.pubDate.replaceAll("-", ".")}</time>
                    <h3 class="font-black leading-snug text-zinc-950 group-hover:text-sky-700 dark:text-zinc-100 dark:group-hover:text-sky-300">{article.title}</h3>
                    <span class:list={["font-mono text-[10px] font-black uppercase", article.source === "Blog" ? "text-amber-700 dark:text-amber-300" : "text-sky-700 dark:text-sky-300"]}>{article.source} ↗</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
      <p id="writing-empty" hidden class="mt-12 rounded-xl border-2 border-dashed border-zinc-500 px-6 py-14 text-center font-mono text-sm font-bold text-zinc-500">一致する記事はありません。</p>
    </main>
    <SiteFooter />
  </div>
</Layout>

<script>
  function bindWritingSearch() {
    const writingInput = document.querySelector<HTMLInputElement>("#writing-search");
    if (!writingInput || writingInput.dataset.bound === "true") return;
    writingInput.dataset.bound = "true";
    writingInput.addEventListener("input", () => {
      const writingItems = Array.from(document.querySelectorAll<HTMLElement>("[data-writing-item]"));
      const writingYears = Array.from(document.querySelectorAll<HTMLElement>("[data-writing-year]"));
      const writingCount = document.querySelector<HTMLElement>("#writing-count");
      const writingEmpty = document.querySelector<HTMLElement>("#writing-empty");
      const terms = writingInput.value.trim().toLocaleLowerCase("ja").split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const item of writingItems) {
        const matches = terms.every((term) => (item.dataset.search ?? "").includes(term));
        item.hidden = !matches;
        if (matches) visible += 1;
      }
      for (const year of writingYears) {
        year.hidden = !year.querySelector("[data-writing-item]:not([hidden])");
      }
      if (writingCount) writingCount.textContent = `${visible} / ${writingItems.length} ARTICLES`;
      if (writingEmpty) writingEmpty.hidden = visible !== 0;
    });
  }

  bindWritingSearch();
  document.addEventListener("astro:page-load", bindWritingSearch);
</script>
