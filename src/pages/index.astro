---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { getZennArticles } from "../lib/zenn";
import PortfolioList from "../components/PortfolioList";
import SiteHeader from "../components/SiteHeader.astro";
import { profile } from "../config";
import { projects } from "../data/projects";

// Projectsは外部APIではなく、src/data/projects.ts を正本にする。
const repos = projects
  .filter((project) => project.featured)
  .sort((a, b) => a.order - b.order)
  .map((project) => ({
    name: project.title,
    description: project.description,
    url: project.github,
    homepageUrl: project.demo ?? null,
    stargazerCount: project.stars,
    primaryLanguage: project.language
      ? {
          name: project.language,
          color: project.languageColor ?? "#71717a",
        }
      : null,
    zenn: project.zenn,
  }));
const articles = await getZennArticles();
---

<Layout
  title={`${profile.name} - Portfolio`}
  description={profile.bio}
  image="/og-image.png"
>
  <SiteHeader />
  <main>
    <PortfolioList
      profile={profile}
      repos={repos}
      articles={articles}
      client:load
    />
  </main>
</Layout>
