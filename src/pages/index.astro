---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { getZennArticles } from "../lib/zenn";
import PortfolioList from "../components/PortfolioList";
import SiteHeader from "../components/SiteHeader.astro";
import { profile } from "../config";
import { getProjectPath, projects } from "../data/projects";

// Projectsは外部APIではなく、src/data/projects.ts を正本にする。
const repos = projects
  .filter((project) => project.featured)
  .sort((a, b) => a.order - b.order)
  .map((project) => ({
    projectUrl: getProjectPath(project),
    name: project.title,
    description: project.description,
    url: project.github,
    homepageUrl: project.demo ?? null,
    stargazerCount: project.stars,
    primaryLanguage: project.language
      ? {
          name: project.language,
          color: project.languageColor ?? "#71717a",
        }
      : null,
    zenn: project.zenn,
  }));
const articles = await getZennArticles(3);
const site = Astro.site ?? new URL("https://kinn-kinn.com");
const personUrl = new URL("/#person", site).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: "kinn00kinn — Software / Research / Writing",
    url: new URL("/", site).href,
    mainEntity: { "@id": personUrl },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": personUrl,
    name: profile.name,
    url: new URL("/", site).href,
    image: new URL(profile.avatarUrl, site).href,
    sameAs: [profile.githubUrl, profile.linkedinUrl, profile.blogUrl, profile.zennUrl, profile.qiitaUrl].filter(Boolean),
    jobTitle: profile.role,
    description: profile.bio,
  },
];
---

<Layout
  title={`${profile.name} — Software / Research / Writing`}
  description="kinn00kinnのソフトウェア、研究、執筆、外部での採用・言及を集約するホームドメイン。"
  image="/og-image.png"
  jsonLd={jsonLd}
>
  <SiteHeader />
  <main>
    <PortfolioList
      profile={profile}
      repos={repos}
      articles={articles}
      client:load
    />
  </main>
</Layout>
