---
// src/layouts/Layout.astro
import { ViewTransitions } from "astro:transitions";
import "../styles/global.css";
import { englishTranslations } from "../i18n";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = "kinn00kinnのソフトウェア、研究、執筆、活動を集約するホームドメイン。",
  image = "/og-image.png",
  imageAlt = title,
  imageWidth = 1200,
  imageHeight = image.endsWith(".webp") ? 675 : 630,
  ogType = "website",
  jsonLd,
} = Astro.props;

// サイトのベースURLを取得 (astro.config.mjsのsite設定、なければローカルホスト)
const site = Astro.site ? Astro.site.href : "http://localhost:4321";

// 画像の完全なURLを生成（URL結合の安全性を高める処理）
const ogImageUrl = new URL(image, site).href;

// カノニカルURLの生成 (正規URL)
// 末尾のスラッシュを一貫させるための処理も含めるとより丁寧ですが、ここではシンプルにパス名を結合します
const canonicalURL = new URL(Astro.url.pathname, site).href;

const defaultJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "kinn00kinn",
  url: site,
  description,
};
const structuredData = jsonLd ?? defaultJsonLd;
const imageType = image.endsWith(".webp") ? "image/webp" : "image/png";
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
  <head>
    <script is:inline>
      (() => {
        let language;
        try { language = localStorage.getItem("language"); } catch {}
        document.documentElement.lang = language === "ja" || language === "en"
          ? language
          : (navigator.language || "").toLowerCase().startsWith("ja") ? "ja" : "en";
      })();
    </script>
    <script is:inline data-astro-rerun>
      (() => {
        const getDarkTheme = () => {
          try {
            const savedTheme = localStorage.getItem("theme");
            return savedTheme === "dark" || (!savedTheme && window.matchMedia("(prefers-color-scheme: dark)").matches);
          } catch {
            return window.matchMedia("(prefers-color-scheme: dark)").matches;
          }
        };
        const applyTheme = (root) => {
          const dark = getDarkTheme();
          root.classList.toggle("dark", dark);
          root.style.colorScheme = dark ? "dark" : "light";
        };

        applyTheme(document.documentElement);
        if (!window.__portfolioThemeListenersBound) {
          window.__portfolioThemeListenersBound = true;
          document.addEventListener("astro:before-swap", (event) => applyTheme(event.newDocument.documentElement));
          document.addEventListener("astro:after-swap", () => applyTheme(document.documentElement));
          document.addEventListener("astro:page-load", () => applyTheme(document.documentElement));
        }
      })();
    </script>
    <script
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-JB2MX4YNF5"></script>
    <script type="text/partytown">
      // TypeScript用の型定義拡張
      // declare global {
      //   interface Window {
      //     dataLayer: any[];
      //   }
      // }

      window.dataLayer = window.dataLayer || [];

      // 関数定義を修正
      function gtag() {
        window.dataLayer.push(arguments);
      }

      // 型キャストしてグローバルスコープに関数を公開（必要な場合）
      // (window as any).gtag = gtag;

      gtag("js", new Date());
      gtag("config", "G-JB2MX4YNF5");
    </script>

    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="kinnkinn" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* --- 構造化データ (JSON-LD) --- */}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    {/* --- OGP設定 (共通) --- */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="kinn00kinn" />

    <meta property="og:locale" content="ja_JP" />

    {/* --- OGP画像設定 (詳細) --- */}
    {/* TeamsやLINEなどのプラットフォームのために詳細情報を追加 */}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:url" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />

    <meta property="og:image:alt" content={imageAlt} />

    {/* --- Twitter Card設定 --- */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* 滑らかな遷移のためのコンポーネント */}
    <ViewTransitions />
  </head>
  <body
    class="bg-white text-slate-900 transition-colors duration-300 dark:bg-[#12110f] dark:text-zinc-200"
  >
    <slot />
    <script is:inline define:vars={{ englishTranslations }}>
      (() => {
        const isEnglish = () => document.documentElement.lang === "en";
        const japaneseTranslations = Object.fromEntries(
          Object.entries(englishTranslations).map(([japanese, english]) => [english, japanese]),
        );
        const translatedAttributes = ["alt", "aria-label", "content", "placeholder", "title"];

        const translateValue = (value) => {
          const translations = isEnglish() ? englishTranslations : japaneseTranslations;
          return translations[value] || value;
        };
        const translateJson = (value) => {
          if (typeof value === "string") return translateValue(value);
          if (Array.isArray(value)) return value.map(translateJson);
          if (value && typeof value === "object") {
            for (const key of Object.keys(value)) value[key] = translateJson(value[key]);
          }
          return value;
        };
        const translateText = (node) => {
          if (!node.nodeValue || ["SCRIPT", "STYLE"].includes(node.parentElement?.tagName)) return;
          const value = node.nodeValue;
          const trimmed = value.trim();
          const translated = translateValue(trimmed);
          if (translated !== trimmed) node.nodeValue = value.replace(trimmed, translated);
        };
        const translateElement = (element) => {
          for (const attribute of translatedAttributes) {
            const value = element.getAttribute(attribute);
            if (value) element.setAttribute(attribute, translateValue(value));
          }
          if (element.matches("[data-search]")) {
            const source = element.dataset.i18nSearchSource || element.dataset.search || "";
            element.dataset.i18nSearchSource = source;
            element.dataset.search = isEnglish()
              ? Object.entries(englishTranslations).reduce(
                  (text, [ja, en]) => text.includes(ja.toLowerCase()) ? `${text} ${en.toLowerCase()}` : text,
                  source.toLowerCase(),
                )
              : source;
          }
          if (element.matches('script[type="application/ld+json"]')) {
            try { element.textContent = JSON.stringify(translateJson(JSON.parse(element.textContent || "{}"))); } catch {}
          }
        };
        const applyLanguage = (root = document) => {
          if (root.nodeType === Node.TEXT_NODE) {
            if (!root.parentElement?.closest("astro-island[ssr]")) translateText(root);
            return;
          }
          const element = root.nodeType === Node.DOCUMENT_NODE ? root.documentElement : root;
          if (element?.nodeType === Node.ELEMENT_NODE) {
            if (!element.closest?.("astro-island[ssr]")) translateElement(element);
            element.querySelectorAll("*").forEach((child) => {
              if (!child.closest("astro-island[ssr]")) translateElement(child);
            });
            const walker = element.ownerDocument.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
              acceptNode: (node) => node.parentElement?.closest("astro-island[ssr]")
                ? NodeFilter.FILTER_REJECT
                : NodeFilter.FILTER_ACCEPT,
            });
            while (walker.nextNode()) translateText(walker.currentNode);
            element.querySelectorAll("astro-island[ssr]").forEach((island) => {
              if (island.dataset.i18nBound === "true") return;
              island.dataset.i18nBound = "true";
              island.addEventListener("astro:hydrate", () => applyLanguage(island), { once: true });
            });
          }
          const targetDocument = element?.ownerDocument || document;
          const ogLocale = targetDocument.querySelector('meta[property="og:locale"]');
          if (ogLocale) ogLocale.setAttribute("content", isEnglish() ? "en_US" : "ja_JP");
        };
        const start = () => {
          applyLanguage(document);
          if (!window.__portfolioLanguageObserver) {
            window.__portfolioLanguageObserver = new MutationObserver((mutations) => {
              for (const mutation of mutations) mutation.addedNodes.forEach((node) => applyLanguage(node));
            });
          }
          window.__portfolioLanguageObserver.disconnect();
          window.__portfolioLanguageObserver.observe(document.body, { childList: true, subtree: true });
        };

        window.__setPortfolioLanguage = (language) => {
          document.documentElement.lang = language;
          applyLanguage(document);
        };

        document.addEventListener("astro:before-swap", (event) => {
          event.newDocument.documentElement.lang = isEnglish() ? "en" : "ja";
          applyLanguage(event.newDocument);
        });
        document.addEventListener("astro:page-load", () => requestAnimationFrame(start));
        if (document.readyState === "complete") requestAnimationFrame(start);
        else window.addEventListener("load", () => requestAnimationFrame(start), { once: true });
      })();
    </script>
  </body>
</html>
