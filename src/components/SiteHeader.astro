---
import { profile } from "../config";

const pathname = Astro.url.pathname;
const links = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/writing/", label: "Writing" },
  { href: "/activity/", label: "Activity" },
];
---

<header class="sticky top-0 z-50 border-b-2 border-zinc-900 bg-[#f4f2ee]/95 backdrop-blur dark:border-zinc-700 dark:bg-[#12110f]/95">
  <div class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2 px-3 py-2 sm:flex sm:justify-between sm:gap-2 sm:py-3 md:px-8">
    <a href="/" class="min-w-0 truncate font-mono text-xs font-black tracking-tight text-zinc-950 dark:text-zinc-100 sm:text-sm">
      {profile.name}<span class="text-emerald-600 dark:text-emerald-400">::_</span>
    </a>
    <nav aria-label="メインナビゲーション" class="order-3 col-span-2 grid w-full grid-cols-4 gap-1 sm:order-none sm:ml-auto sm:flex sm:w-auto sm:items-center sm:gap-1 md:gap-2">
      {links.map((link) => {
        const active = link.href === "/" ? pathname === "/" : pathname.startsWith(link.href);
        return (
          <a
            href={link.href}
            aria-current={active ? "page" : undefined}
            class:list={[
              "min-w-0 rounded-md px-1.5 py-2 text-center font-mono text-[10px] font-black uppercase tracking-tight transition-colors sm:px-3 sm:text-xs sm:tracking-wider md:px-4",
              active
                ? "bg-zinc-900 text-white dark:bg-zinc-200 dark:text-zinc-900"
                : "text-zinc-500 hover:bg-zinc-200 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-[#26231f] dark:hover:text-zinc-100",
            ]}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
    <div class="flex shrink-0 items-center gap-1.5">
      <button
        id="language-toggle"
        type="button"
        aria-label="Switch to English"
        title="Switch to English"
        class="grid h-9 min-w-9 place-items-center rounded-full border-2 border-zinc-900 bg-white px-2 font-mono text-[10px] font-black text-zinc-900 transition-transform hover:-translate-y-0.5 dark:border-zinc-600 dark:bg-[#1c1a17] dark:text-zinc-200"
      >
        EN
      </button>
      <button
        id="theme-toggle"
        type="button"
        aria-label="カラーテーマを切り替える"
        title="カラーテーマを切り替える"
        class="grid h-9 w-9 place-items-center rounded-full border-2 border-zinc-900 bg-white text-zinc-900 transition-transform hover:-translate-y-0.5 dark:border-zinc-600 dark:bg-[#1c1a17] dark:text-zinc-200"
      >
        <svg class="h-4 w-4 dark:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a6 6 0 1 0 9 9 9 9 0 0 1-9-9Z" /></svg>
        <svg class="hidden h-4 w-4 dark:block" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" /></svg>
      </button>
    </div>
  </div>
</header>

<script>
  function bindThemeToggle() {
    const themeButton = document.querySelector<HTMLButtonElement>("#theme-toggle");
    if (!themeButton || themeButton.dataset.bound === "true") return;

    themeButton.dataset.bound = "true";
    themeButton.setAttribute("aria-pressed", String(document.documentElement.classList.contains("dark")));
    themeButton.addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", dark ? "dark" : "light");
      document.documentElement.style.colorScheme = dark ? "dark" : "light";
      themeButton.setAttribute("aria-pressed", String(dark));
    });
  }

  function bindLanguageToggle() {
    const languageButton = document.querySelector<HTMLButtonElement>("#language-toggle");
    if (!languageButton) return;

    const updateButton = () => {
      const japanese = document.documentElement.lang === "ja";
      languageButton.textContent = japanese ? "EN" : "JA";
      languageButton.setAttribute("aria-label", japanese ? "Switch to English" : "日本語に切り替える");
      languageButton.title = japanese ? "Switch to English" : "日本語に切り替える";
      languageButton.setAttribute("aria-pressed", String(!japanese));
    };

    updateButton();
    if (languageButton.dataset.bound === "true") return;
    languageButton.dataset.bound = "true";
    languageButton.addEventListener("click", () => {
      const language = document.documentElement.lang === "ja" ? "en" : "ja";
      localStorage.setItem("language", language);
      const languageWindow = window as Window & {
        __setPortfolioLanguage?: (language: "ja" | "en") => void;
      };
      if (languageWindow.__setPortfolioLanguage) {
        languageWindow.__setPortfolioLanguage(language);
        updateButton();
      } else {
        window.location.reload();
      }
    });
  }

  bindThemeToggle();
  bindLanguageToggle();
  document.addEventListener("astro:page-load", bindThemeToggle);
  document.addEventListener("astro:page-load", bindLanguageToggle);
</script>
