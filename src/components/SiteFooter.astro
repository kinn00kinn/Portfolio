---
import { profile } from "../config";
---

<footer class="mx-auto max-w-6xl px-4 py-12 md:px-8">
  <div class="flex flex-col gap-3 border-t border-dashed border-zinc-400 pt-6 font-mono text-xs text-zinc-500 dark:border-zinc-700 dark:text-zinc-400 sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <div class="flex gap-4">
      <a class="hover:text-zinc-950 dark:hover:text-white" href={profile.githubUrl} target="_blank" rel="noreferrer">GitHub</a>
      <a class="hover:text-zinc-950 dark:hover:text-white" href={profile.zennUrl} target="_blank" rel="noreferrer">Zenn</a>
    </div>
  </div>
</footer>
